<html>
    <head>
        <title>About Me</title>
        <style>
            input[type="text"] {
                width: 100%;
            }
        </style>
        <script>
            function calculate() {
                var a = parseFloat(myform.a.value);
                var b = parseFloat(myform.b.value);
                var c = parseFloat(myform.c.value);
                var result;
                if (a === 0) {
                    if (b === 0) {
                        if (c === 0) {
                            result = "Infinite solutions";
                        } else {
                            result = "No solution";
                        }
                    } else {
                        result = "x = " + (-c / b);
                    }
                } else {
                    var delta = b * b - 4 * a * c;
                    if (delta > 0) {
                        var x1 = (-b + Math.sqrt(delta)) / (2 * a);
                        var x2 = (-b - Math.sqrt(delta)) / (2 * a);
                        result = "x1 = " + x1 + ", x2 = " + x2;
                    } else if (delta === 0) {
                        var x = -b / (2 * a);
                        result = " x = " + x;
                    } else {
                        result = "No real solutions";
                    }
                }
                myform.result.value = result;
            }
        </script>
    </head>
    <body>
        <form name="myform">
            <table border="1" style="text-align: center;">
                <tr>
                    <td>a:</td>
                    <td><input type="text" name="a"></td>
                </tr>
                <tr>
                    <td>b:</td>
                    <td><input type="text" name="b"></td>
                </tr>
                <tr>
                    <td>c:</td>
                    <td><input type="text" name="c"></td>
                </tr>
                <tr>
                    <td>Result</td>
                    <td><input type="text" name="result" readonly></td>
                </tr>
                <tr>
                    <td>
                    </td>
                    <td>
                        <button type="button" name="Find solution" onclick="calculate()">Find solution</button>
                        <button type="reset" name="Clear">Clear</button>
                    </td>
                </tr>
            </table>
        </form>
    </body>
</html>
