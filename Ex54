<html>
    <head>
        <title>About Me</title>
        <style>
            input[type="text"] {
                width: 100%;
            }
        </style>
        <script>
            function calculate() {
                var a = parseFloat(myform.a.value);
                var b = parseFloat(myform.b.value);
                var c = parseFloat(myform.c.value);
                var result;
                var buttonName = event.target.name;
                if (buttonName === "Max") {
                    result = Math.max(a, b, c);
                } else if (buttonName === "Min") {
                    result = Math.min(a, b, c);
                } else if (buttonName === "sin(a)") {
                    result = Math.sin(a);
                } else if (buttonName === "cos(a)") {
                    result = Math.cos(a);
                } else if (buttonName === "a^b") {
                    result = Math.pow(a, b);
                }
                myform.result.value = result;
            }
        </script>
    </head>
    <body>
        <form name="myform">
            <table border="1" style="text-align: center;">
                <tr>
                    <td>a:</td>
                    <td><input type="text" name="a"></td>
                </tr>
                <tr>
                    <td>b:</td>
                    <td><input type="text" name="b"></td>
                </tr>
                <tr>
                    <td>c:</td>
                    <td><input type="text" name="c"></td>
                </tr>
                <tr>
                    <td>Result</td>
                    <td><input type="text" name="result" readonly></td>
                </tr>
                <tr>
                    <td colspan="2">
                        <button type="button" name="Max" id="Max" onclick="calculate()">MAX</button>
                        <button type="button" name="Min" id="Min" onclick="calculate()">MIN</button>
                        <button type="button" name="sin(a)" id="sin(a)" onclick="calculate()">sin(a)</button>
                        <button type="button" name="cos(a)" id="cos(a)" onclick="calculate()">cos(a)</button>
                        <button type="button" name="a^b" id="a^b" onclick="calculate()">a^b</button>
                    </td>
                </tr>
            </table>
        </form>
    </body>
</html>
